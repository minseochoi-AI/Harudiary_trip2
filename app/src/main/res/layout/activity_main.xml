<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- ★ 프래그먼트 컨테이너 (상단 inset 패딩을 코드에서 적용) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 구분선 -->
    <View
        android:id="@+id/nav_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_border" />

    <!-- ★ 하단 내비게이션 바 (하단 inset 패딩을 코드에서 적용) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingHorizontal="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <!-- 홈 탭 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:id="@+id/nav_home_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textSize="10sp"
                android:textColor="@color/gray_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 기록 탭 -->
        <LinearLayout
            android:id="@+id/nav_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:id="@+id/nav_list_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기록"
                android:textSize="10sp"
                android:textColor="@color/gray_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- FAB + 버튼 (중앙) -->
        <FrameLayout
            android:id="@+id/nav_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="8dp"
            android:layout_gravity="center_vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textSize="30sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_fab_add" />
        </FrameLayout>

        <!-- 친구 탭 -->
        <LinearLayout
            android:id="@+id/nav_friend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:id="@+id/nav_friend_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="친구"
                android:textSize="10sp"
                android:textColor="@color/gray_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 프로필 탭 -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:id="@+id/nav_settings_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필"
                android:textSize="10sp"
                android:textColor="@color/gray_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
