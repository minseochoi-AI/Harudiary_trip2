<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 드래그 핸들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_drag_handle" />
    </LinearLayout>

    <!-- 타이틀 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="반응"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp" />

    <!-- 구분선 -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/gray_border"/>

    <!-- 댓글 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- 댓글 없을 때 -->
    <TextView
        android:id="@+id/tv_no_comments"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="첫 번째 반응을 남겨보세요 💬"
        android:textColor="@color/gray_hint"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 구분선 -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/gray_border"/>

    <!-- 입력 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_input"
            android:paddingHorizontal="14dp"
            android:hint="반응 남기기..."
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:textColorHint="@color/gray_hint"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:imeOptions="actionSend"
            android:singleLine="false" />

        <TextView
            android:id="@+id/btn_send_comment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="↑"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>

    <!-- 키보드 여백 -->
    <View android:layout_width="match_parent" android:layout_height="8dp" />

</LinearLayout>
