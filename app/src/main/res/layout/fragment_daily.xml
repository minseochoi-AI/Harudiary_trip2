<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <!-- 상단 바: ← [날짜 + 공유] [지도 핀] -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="8dp"
        android:background="#FFFFFF"
        android:elevation="1dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:text="←"
            android:textColor="@color/gray_label"
            android:textSize="22sp" />

        <!-- 날짜 + 공유 버튼 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_share_btn"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tv_date_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="↑"
                android:textColor="@color/gray_hint"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 삭제 버튼 + 날씨 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_delete_records"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🗑"
                android:textSize="17sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </RelativeLayout>

    <!-- 하루 제목 입력 -->
    <EditText
        android:id="@+id/et_day_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:hint="이날 하루 제목을 지어주세요"
        android:textSize="15sp"
        android:textColor="@color/primary"
        android:textColorHint="@color/gray_hint"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:singleLine="true" />

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_border" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
