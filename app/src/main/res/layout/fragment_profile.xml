<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="프로필"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_save_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/gray_border"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 프로필 이미지 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:paddingVertical="32dp"
                android:layout_marginBottom="12dp">

                <!-- 프로필 이미지 원형 -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <!-- 기본 아바타 (이미지 없을 때) -->
                    <TextView
                        android:id="@+id/tv_profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <!-- 프로필 이미지 (설정됐을 때 표시) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="3dp"
                        android:visibility="gone"
                        android:contentDescription="프로필 사진" />

                    <!-- 카메라 아이콘 (우하단) -->
                    <TextView
                        android:id="@+id/btn_change_photo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_fab_add"
                        android:gravity="center"
                        android:text="📷"
                        android:textSize="14sp" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="프로필 사진 변경"
                    android:textColor="@color/gray_hint"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 이름 수정 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이름"
                    android:textColor="@color/gray_hint"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_title_input"
                    android:paddingHorizontal="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/primary"
                    android:inputType="textPersonName"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:hint="이름을 입력하세요" />

            </LinearLayout>

            <!-- 이메일 (읽기 전용) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일 (변경 불가)"
                    android:textColor="@color/gray_hint"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F5F5F5"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical"
                    android:textSize="15sp"
                    android:textColor="@color/gray_hint" />

            </LinearLayout>

            <!-- 로그아웃 / 회원탈퇴 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btn_logout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="로그아웃"
                    android:textColor="@color/gray_label"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_outline"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_withdraw"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="회원탈퇴"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_outline" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
