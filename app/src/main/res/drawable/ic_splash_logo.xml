        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- 아이콘 포그라운드 (108dp viewport 기준, 중앙 72dp 세이프존) -->
